# The game slug on Boxity. Already built in (1-muscle-to-push-boulder); set it only to
# test under another slug. Copy this file to `.env` (or `.env.local`) to use it.
# VITE_GAME_SLUG=1-muscle-to-push-boulder

# Which Boxity (prod, stage or local) is never set here: Boxity tells the pages it serves,
# and a page told nothing uses production. To run against a whole Boxity stack on this
# machine, start the dev server with BLOXITY_LOCAL=1 (see vite.config.js).

# Hosted on Bloxity Legion: join through its matchmaker (the deploy workflow sets
# this for hosted builds).
# VITE_LEGION_GAME_ID=1-muscle-to-push-boulder

# Or a game server (Colyseus) reached directly. Leave both unset in development to use
# http://<host>:2567; a production build with neither plays offline with a local save.
# VITE_SERVER_URL=https://game.example.com

